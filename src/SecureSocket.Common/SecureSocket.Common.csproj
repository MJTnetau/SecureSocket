<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SecureSocket</RootNamespace>
    <AssemblyName>SecureSocket.Common</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>SecureSocket.Common</PackageId>
    <Version>1.1.0</Version>
    <Title>SecureSocket Common Library</Title>
    <Authors>SecureSocket Contributors</Authors>
    <Description>Common wire protocol framing, zero-allocation pipeline parsers, and certificate utilities for SecureSocket.</Description>
    <PackageTags>socket;tls;ssl;pipelines;framing;zero-allocation;high-performance;async;network</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SecureSocket/SecureSocket</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SecureSocket/SecureSocket.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
